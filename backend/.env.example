# ==============================================================================
# RainLoc - Configuración de Entorno y Claves de API
# ==============================================================================
# INSTRUCCIONES:
# Copia este archivo a `.env` en la carpeta backend/ y rellena tus claves.
# El archivo `.env` está en .gitignore y NUNCA se subirá a GitHub ni a la web pública.
# ==============================================================================

# Clave API de AEMET OpenData (Obligatoria para fallback de Cullera, Murcia, etc.)
# Obtén tu clave gratuita en: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=tu_api_key_de_aemet_aqui

# Configuración del Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Configuración de Sincronización (en segundos)
RADAR_POLL_INTERVAL_SECONDS=60
AEMET_REFRESH_INTERVAL_SECONDS=180
ECMWF_POLL_INTERVAL_SECONDS=1800
GFS_POLL_INTERVAL_SECONDS=1800
AROME_POLL_INTERVAL_SECONDS=1800
