{
  "name": "RainLoc - Visor de Cuencas Hidrográficas",
  "short_name": "RainLoc",
  "description": "Visor SIG para monitorización y anticipación de episodios de lluvias torrenciales y caudales en cuencas de la Comunitat Valenciana (CHJ).",
  "start_url": "./index.html",
  "id": "rainloc-app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b1120",
  "theme_color": "#0b1120",
  "categories": ["weather", "utilities", "navigation"],
  "lang": "es-ES",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
